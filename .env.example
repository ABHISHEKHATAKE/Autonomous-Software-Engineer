SECRET_KEY=dev-secret-key-change-me
ENVIRONMENT=development
POSTGRES_DB=ase
POSTGRES_USER=ase
POSTGRES_PASSWORD=ase_dev_password
# Required for Groq-backed agents. GROQ_MODEL defaults to qwen/qwen3.8-27b.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional GitHub OAuth App; alternatively users can enter a verified PAT in the dashboard.
GITHUB_API_URL=https://api.github.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/oauth/callback
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker task runner defaults.
EXECUTION_IMAGE=ase-backend:local
EXECUTION_NETWORK=none
